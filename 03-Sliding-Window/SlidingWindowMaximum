/**
 * Pattern: Sliding Window / Monotonic Queue
 * Problem: Sliding Window Maximum (LeetCode #239)
 * Link: https://leetcode.com
 *
 * Approach:
 * Maintain a monotonic decreasing deque storing indices of useful elements
 * in the current window of size 'k'. Remove indices that fall out of the
 * window from the front, and pop smaller elements from the back so the front
 * always holds the maximum element's index.
 *
 * Time Complexity: O(n)
 * Space Complexity: O(k)
 */

import java.util.ArrayDeque;
import java.util.Arrays;
import java.util.Deque;

public class SlidingWindowMaximum {

    
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n = nums.length;
        int[] result = new int[n - k + 1];
        Deque<Integer> windowIndex = new ArrayDeque<>(); // Stores indices

        for (int i = 0; i < n; i++) {
            // Out of window index ko front se nikalo
            if (!windowIndex.isEmpty() && windowIndex.peekFirst() <= i - k) {
                windowIndex.pollFirst();
            }

            // Current element se chhote elements ko peeche se nikalo
            while (!windowIndex.isEmpty() && nums[windowIndex.peekLast()] <= nums[i]) {
                windowIndex.pollLast();
            }

            // Current index ko rear me daalo
            windowIndex.offerLast(i);

            // Jab pehli window (size k) ban jaye, answer record karo
            if (i >= k - 1) {
                result[i - k + 1] = nums[windowIndex.peekFirst()];
            }
        }

        return result;
    }

   
    public static void main(String[] args) {
        SlidingWindowMaximum solver = new SlidingWindowMaximum();

        int[] nums1 = {1, 3, -1, -3, 5, 3, 6, 7};
        int k1 = 3;
        System.out.println("Test 1: " + Arrays.toString(solver.maxSlidingWindow(nums1, k1))); // [3, 3, 5, 5, 6, 7]

        int[] nums2 = {2};
        int k2 = 1;
        System.out.println("Test 2: " + Arrays.toString(solver.maxSlidingWindow(nums2, k2))); // [2]
    }
}
